<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/romanMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/roman_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/romanEditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:autofillHints=""
            android:hint="@string/roman_hint"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:maxWidth="420dp"
            android:minWidth="320dp"
            android:minHeight="48dp"
            android:textColorHint="#5F6368" />

        <Button
            android:id="@+id/convertRomanButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxWidth="420dp"
            android:minWidth="320dp"
            android:text="@string/convert" />

        <TextView
            android:id="@+id/romanResultTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/result_placeholder"
            android:textSize="18sp" />

    </LinearLayout>
</ScrollView>
