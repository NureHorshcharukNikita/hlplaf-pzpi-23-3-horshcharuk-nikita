<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gameMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/game_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wordTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/attemptsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/letterEditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:autofillHints=""
            android:hint="@string/letter_hint"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:maxLength="1"
            android:maxWidth="420dp"
            android:minWidth="320dp"
            android:minHeight="48dp"
            android:textColorHint="#5F6368" />

        <Button
            android:id="@+id/checkLetterButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxWidth="420dp"
            android:minWidth="320dp"
            android:text="@string/check_letter" />

        <Button
            android:id="@+id/restartGameButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="420dp"
            android:minWidth="320dp"
            android:text="@string/new_game" />

        <TextView
            android:id="@+id/gameMessageTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="18sp" />

    </LinearLayout>
</ScrollView>
